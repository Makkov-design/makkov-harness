#!/usr/bin/env bash
# PreToolUse hook (Claude Code): before a shell command that installs or runs third-party code, Claude Code
# asks you first, and the agent is reminded to review it with the third-party-install-guard skill.
# It never blocks a command and never runs one: it only turns an automatic run into a question.
# What it matches and what it does not is listed in SECURITY.md (hooks/install-gate); hooks/install-corpus.json holds
# the test cases.
# Not asked about: installs from an existing lockfile (npm ci, plain npm/pnpm/yarn install), npx for a tool
# already installed in the project (node_modules/.bin), and install words inside a commit or PR message.
# Off with MAKKOV_HARNESS_INSTALL_GATE=off (for example in a headless `claude -p` run, where nobody can answer).
# With MAKKOV_HARNESS_SCOPE=design it is off too, as installs are outside that scope; MAKKOV_HARNESS_INSTALL_GATE=on
# keeps it on. Pure bash 3.2: reads the hook input from stdin, starts no other program, no network, writes nothing.
set -u
gate="${MAKKOV_HARNESS_INSTALL_GATE:-}"
[ "$gate" = off ] && exit 0
[ "${MAKKOV_HARNESS_SCOPE:-}" = design ] && [ "$gate" != on ] && exit 0

IFS= read -r -d '' input || true
re_cmd='"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
[[ $input =~ $re_cmd ]] || exit 0
cmd="${BASH_REMATCH[1]}"
cwd=""
re_cwd='"cwd"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
[[ $input =~ $re_cwd ]] && cwd="${BASH_REMATCH[1]}"

# Decode the JSON escapes that change where words start. Escaped backslashes are set aside first, so a literal
# backslash-n stays text; a backslash at the end of a line continues the line; other line breaks and tabs become
# separators; escaped quotes become themselves.
P=$'\037'   # a unit separator; not \001, which bash uses internally
cmd="${cmd//\\\\/$P}"
cmd="${cmd//${P}\\r\\n/ }"; cmd="${cmd//${P}\\n/ }"
cmd="${cmd//\\n/ ; }"; cmd="${cmd//\\r/ }"; cmd="${cmd//\\t/ }"; cmd="${cmd//\\\"/\"}"
cmd="${cmd//$P/\\}"
cwd="${cwd//\\\\/\\}"
c=" $cmd "

w='[^[:space:];&|"'"'"')]'            # one character of a word
dq='"([^"\\]|\\.)*"'; sq="'[^']*'"

# A commit or PR message is text, not a command: blank a quoted -m/--message/--body/--title/--notes value.
# A value that runs a command substitution keeps it, except the usual "$(cat <<'EOF' … EOF)" message.
re_msg="(^|[[:space:]])(-m|--message|--body|--title|--notes|--subject)(=|[[:space:]]+)(${dq}|${sq})"
out=""; rest="$c"
while [[ $rest =~ $re_msg ]]; do
  m="${BASH_REMATCH[0]}"; v="${BASH_REMATCH[4]}"
  new="${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}\"\""
  body="${v#\"\$(cat <<}"                 # an unquoted heredoc still expands a $( ) or a backtick in its body
  case "$body" in *'$('*|*'`'*) new="$m" ;; esac
  out="$out${rest%%"$m"*}$new"; rest="${rest#*"$m"}"
done
c="$out$rest"

# Options that take a value become one word (--prefix app -> --prefix=app), so the value is not read as a package.
# Case-sensitive on purpose: -w and -C differ from -W and -c.
re_vf="([[:space:]](--prefix|--workspace|-w|--filter|-F|--dir|-C|--cwd|--registry|--cache|--omit|--include|--loglevel|--userconfig))[[:space:]]+([^-[:space:];&|\"')]${w}*)"
out=""; rest="$c"
while [[ $rest =~ $re_vf ]]; do
  m="${BASH_REMATCH[0]}"
  out="$out${rest%%"$m"*}${BASH_REMATCH[1]}=${BASH_REMATCH[3]}"; rest="${rest#*"$m"}"
done
c="$out$rest"
shopt -s nocasematch

b="(^|[[:space:];&|(\`\"'{])"        # a word starts after a space, a separator, a bracket or a quote
path="(${w}*[/\\])?"                  # an optional path before a program: /usr/bin/, venv/bin/, .\tools\
flag="[[:space:]]+-${w}*([[:space:]]+[^-[:space:];&|\"')]${w}*)?"   # an option, with an optional value
flags="([[:space:]]+-${w}*)*"         # options without values
pkg="[[:space:]]+[^-[:space:];&|\"')]" # a word that is not an option: a package
pm="${b}${path}(npm|pnpm|yarn|bun)(\.cmd|\.exe)?(${flag})*"
npm_add='(install|i|in|ins|inst|insta|instal|isnt|isnta|isntal|isntall|add|it|install-test|create|init)'
shell="${path}(ba|z|da|k|fi)?sh(\.exe)?"
end='([[:space:]]|$|["'"'"')`;&|])'                       # the end of a word
interp="${path}((ba|z|da|k|fi)?sh|pwsh|powershell)(\.exe)?${end}"  # a shell runs its stdin, whatever the options
# python, node, perl and ruby run their stdin only with no script: alone or with "-" (python3 -m json.tool reads data)
interp2="${path}(python[0-9.]*|py|node|perl|ruby)(\.exe)?([[:space:]]+-)?[[:space:]]*($|[\"')\`;&|])"
fetch="${path}(curl|wget)(\.exe)?"
ps_fetch='(iwr|irm|invoke-webrequest|invoke-restmethod|new-object|\[?(system\.)?net\.webclient)'
subst='(\$\(|`)'
sudo="(sudo(${flag})*[[:space:]]+|env([[:space:]]+${w}+=${w}*)*[[:space:]]+)*"

patterns=(
  "${pm}[[:space:]]+${npm_add}${flags}${pkg}"
  "${pm}[[:space:]]+global[[:space:]]+add[[:space:]]"
  "${b}${path}(pnpm|yarn|bun)(\.cmd|\.exe)?(${flag})*[[:space:]]+dlx[[:space:]]"
  "${b}${path}npm(\.cmd)?(${flag})*[[:space:]]+(exec|x)[[:space:]]"
  "${b}${path}(npx|pnpx|bunx|uvx)(\.cmd)?${flags}[[:space:]]+(-p|--package|-c|--call|--from|--with)([[:space:]=]|$)"
  "${b}${path}(pip[0-9.]*|(python[0-9.]*|py)(\.exe)?${flags}[[:space:]]+-m[[:space:]]+pip)(\.exe)?(${flag})*[[:space:]]+install[[:space:]]"
  "${b}${path}uv(\.exe)?(${flag})*[[:space:]]+(add|tool[[:space:]]+(install|run)|pip[[:space:]]+install)[[:space:]]"
  "${b}${path}pipx(\.exe)?(${flag})*[[:space:]]+(install|run|inject)[[:space:]]"
  "${b}${path}(poetry|pdm|rye|bundle|cargo)(\.exe)?(${flag})*[[:space:]]+add[[:space:]]"
  "${b}${path}(cargo|gem|conda|mamba|micromamba)(\.exe)?(${flag})*[[:space:]]+(install|binstall)[[:space:]]"
  "${b}${path}go(\.exe)?(${flag})*[[:space:]]+(install|get)[[:space:]]"
  "${b}${path}go(\.exe)?[[:space:]]+run${flags}[[:space:]]+${w}+@"
  "${b}${path}composer(\.phar)?(${flag})*[[:space:]]+(global[[:space:]]+)?require[[:space:]]"
  "${b}${path}deno(\.exe)?(${flag})*[[:space:]]+(add[[:space:]]|install${flags}${pkg})"
  "${b}${path}(brew|winget|choco|scoop|apt|apt-get|aptitude|dnf|yum|zypper|pacman|yay|snap|flatpak|port)(\.exe)?(${flag})*[[:space:]]+(install[[:space:]]|-S[yu]*${pkg})"
  "${b}${path}apk(${flag})*[[:space:]]+add[[:space:]]"
  "${b}${path}claude(\.exe)?[[:space:]]+(plugin[[:space:]]+(install|marketplace[[:space:]]+add)|mcp[[:space:]]+add(-json)?)[[:space:]]"
  "${b}${path}(code|code-insiders|codium|cursor|windsurf)(\.cmd|\.exe)?(${flag})*[[:space:]]+--install-extension[[:space:]]"
  "${b}${path}gh(\.exe)?[[:space:]]+(extension|extensions|ext)[[:space:]]+install[[:space:]]"
  "${b}${path}(docker|podman|nerdctl)(\.exe)?(${flag})*[[:space:]]+(container[[:space:]]+)?run[[:space:]]"
  # curl … | sh (any number of pipes between, sudo with options, env, a path, other interpreters)
  "${fetch}([^;&]*[^|;&])?\|[[:space:]]*${sudo}(${interp}|${interp2})"
  # sh -c "\$(curl …)", eval "\$(curl …)", bash <(curl …), source <(curl …)
  "${b}${sudo}(${shell}([[:space:]]+-${w}*)*[[:space:]]+-[a-z]*c|eval)[[:space:]]+[\"']?${subst}[[:space:]]*${fetch}[[:space:]]"
  "${b}${sudo}(${shell}([[:space:]]+-${w}*)*|source|\.)[[:space:]]+(<[[:space:]]*)?<\([[:space:]]*${fetch}[[:space:]]"
  # PowerShell: iwr … | iex, iex (irm …), iex ((New-Object Net.WebClient).DownloadString(…)), [scriptblock]::Create((irm …))
  "(iwr|irm|invoke-webrequest|invoke-restmethod|curl|wget)[^;&]*\|[[:space:]]*(iex|invoke-expression)"
  "${b}(iex|invoke-expression)[[:space:](\$]*${ps_fetch}"
  "\[scriptblock\]::create[[:space:](\$]*${ps_fetch}"
)
hit=""
for p in "${patterns[@]}"; do
  if [[ $c =~ $p ]]; then hit=1; break; fi
done

# npx, bunx, uvx, pnpx, bun x: ask unless the tool is already installed in this project, without a version.
if [ -z "$hit" ]; then
  rest="$c"
  re_npx="${b}${path}(npx|bunx|uvx|pnpx|bun[[:space:]]+x)(\.cmd)?${flags}[[:space:]]+([^-[:space:];&|\"')]${w}*)"
  while [[ $rest =~ $re_npx ]]; do
    tool="${BASH_REMATCH[$((${#BASH_REMATCH[@]} - 1))]}"
    rest="${rest#*"${BASH_REMATCH[0]}"}"
    local_bin=""
    if [ -n "$cwd" ] && [[ $tool != *@* || $tool == @*/* && ${tool#@} != *@* ]]; then
      name="${tool##*/}"
      for f in "$cwd/node_modules/.bin/$name" "$cwd/node_modules/.bin/$name.cmd"; do
        [ -e "$f" ] && local_bin=1
      done
    fi
    [ -z "$local_bin" ] && { hit=1; break; }
  done
fi
[ -z "$hit" ] && exit 0

reason="makkov-harness install gate: this command installs or runs third-party code. Review it with the third-party-install-guard skill first (fetch without running, scan, read the hooks and scripts, give a Green, Yellow or Red verdict), then approve only what passed. Turn this check off with MAKKOV_HARNESS_INSTALL_GATE=off."
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"%s"}}\n' "$reason"
exit 0
