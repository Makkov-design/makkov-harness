#!/usr/bin/env bash
# PreToolUse hook (Claude Code): before a shell command that installs or runs third-party code, Claude Code
# asks you first, and the agent is reminded to review it with the third-party-install-guard skill.
# It never blocks a command and never runs one: it only turns an automatic run into a question.
# Not asked about: installs from an existing lockfile (npm ci, plain npm/pnpm/yarn install), and npx for a
# tool already installed in the project (node_modules/.bin). Turn the check off with MAKKOV_HARNESS_INSTALL_GATE=off.
# Pure bash: reads the hook input from stdin, starts no other program, makes no network calls, writes nothing.
set -u
[ "${MAKKOV_HARNESS_INSTALL_GATE:-on}" = "off" ] && exit 0

IFS= read -r -d '' input || true
re_cmd='"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
[[ $input =~ $re_cmd ]] || exit 0
cmd="${BASH_REMATCH[1]}"
cwd=""
re_cwd='"cwd"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
[[ $input =~ $re_cwd ]] && cwd="${BASH_REMATCH[1]}"

# Decode the JSON escapes that change where words start: line breaks and tabs become separators,
# escaped quotes and backslashes become themselves.
cmd="${cmd//\\n/ ; }"; cmd="${cmd//\\r/ }"; cmd="${cmd//\\t/ }"
cmd="${cmd//\\\"/\"}"; cmd="${cmd//\\\\/\\}"
cwd="${cwd//\\\\/\\}"
c=" $cmd "
shopt -s nocasematch

b="(^|[[:space:];&|(\`\"'{])"        # a word starts after a space, a separator, a bracket or a quote
w='[^[:space:];&|"'"'"')]'            # one character of a word
flag="[[:space:]]+-${w}*([[:space:]]+[^-[:space:];&|\"')]${w}*)?"   # an option, with an optional value

patterns=(
  "${b}(npm|pnpm|yarn|bun)(\.cmd)?(${flag})*[[:space:]]+(install|i|add)([[:space:]]+-${w}*)*[[:space:]]+[^-[:space:];&|\"')]"
  "${b}(pnpm|yarn|bun)(\.cmd)?[[:space:]]+dlx[[:space:]]"
  "${b}npm(\.cmd)?[[:space:]]+(exec|x)[[:space:]]"
  "${b}(pip[0-9.]*|(python[0-9.]*|py)[[:space:]]+-m[[:space:]]+pip)[[:space:]]+install[[:space:]]"
  "${b}uv[[:space:]]+(add|tool[[:space:]]+install|pip[[:space:]]+install)[[:space:]]"
  "${b}pipx[[:space:]]+(install|run)[[:space:]]"
  "${b}(cargo|go|gem)[[:space:]]+install[[:space:]]"
  "${b}(brew|winget|choco|scoop|apt|apt-get|dnf|yum|pacman)[[:space:]]+(install|-S)[[:space:]]"
  "${b}claude[[:space:]]+(plugin[[:space:]]+install|mcp[[:space:]]+add)[[:space:]]"
  "${b}code(\.cmd)?[[:space:]]+--install-extension[[:space:]]"
  "(curl|wget)[^|;]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z)?sh([[:space:]]|$|[\"'])"
  "(iwr|irm|invoke-webrequest|invoke-restmethod)[^|;]*\|[[:space:]]*(iex|invoke-expression)"
)
hit=""
for p in "${patterns[@]}"; do
  if [[ $c =~ $p ]]; then hit=1; break; fi
done

# npx, bunx, uvx, pnpx: ask unless the tool is already installed in this project, without a version.
if [ -z "$hit" ]; then
  rest="$c"
  re_npx="${b}(npx|bunx|uvx|pnpx)(\.cmd)?((${flag})*)[[:space:]]+([^-[:space:];&|\"')]${w}*)"
  while [[ $rest =~ $re_npx ]]; do
    tool="${BASH_REMATCH[$((${#BASH_REMATCH[@]} - 1))]}"
    rest="${rest#*"${BASH_REMATCH[0]}"}"
    local_bin=""
    if [ -n "$cwd" ] && [[ $tool != *@* || $tool == @*/* && ${tool#@} != *@* ]]; then
      name="${tool##*/}"
      for f in "$cwd/node_modules/.bin/$name" "$cwd/node_modules/.bin/$name.cmd"; do
        [ -e "$f" ] && local_bin=1
      done
    fi
    [ -z "$local_bin" ] && { hit=1; break; }
  done
fi
[ -z "$hit" ] && exit 0

reason="makkov-harness install gate: this command installs or runs third-party code. Review it with the third-party-install-guard skill first (fetch without running, scan, read the hooks and scripts, give a Green, Yellow or Red verdict), then approve only what passed. Turn this check off with MAKKOV_HARNESS_INSTALL_GATE=off."
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"%s"}}\n' "$reason"
exit 0
