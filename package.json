{
  "name": "makkov-harness",
  "version": "0.5.0",
  "description": "A designer's harness for AI agents: installs curated design skills and a situation-to-skill routing map for Codex, Cursor, Gemini CLI, GitHub Copilot, Windsurf, Cline, OpenCode and Aider.",
  "keywords": [
    "ai-agents",
    "design",
    "skills",
    "codex",
    "cursor",
    "gemini",
    "copilot",
    "agents-md"
  ],
  "homepage": "https://github.com/Makkov-design/makkov-harness",
  "bugs": "https://github.com/Makkov-design/makkov-harness/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makkov-design/makkov-harness.git"
  },
  "license": "MIT",
  "author": "Makkov (https://github.com/Makkov-design)",
  "bin": {
    "makkov-harness": "bin/makkov-harness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/makkov-harness.mjs",
    "install/node/*.mjs",
    "!install/node/*.test.mjs",
    "install/node/fingerprints.json",
    "skills/",
    "!skills/rich-report/",
    "!**/__pycache__/",
    "ROUTING.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CREDITS.md",
    "SECURITY.md"
  ]
}
